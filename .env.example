# DeepSeek API Key (required - for chat/LLM)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Ollama (required - for local embeddings, no API key needed)
# Install: brew install ollama
# Start: ollama serve
# Pull model: ollama pull nomic-embed-text
# Default URL: http://localhost:11434

# Chroma DB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Server port
SERVER_PORT=8080

# Knowledge storage path
KNOWLEDGE_PATH=./data/knowledge

# Web search
# Provider: searxng (recommended, requires Docker) or duckduckgo (free but may trigger CAPTCHA)
WEBSEARCH_PROVIDER=searxng
# SearXNG local URL (runs via docker-compose)
SEARXNG_URL=http://localhost:8081
# Proxy for outbound HTTP (enable if behind firewall/VPN, e.g. Clash/Surge/V2Ray)
PROXY_ENABLED=false
PROXY_HOST=127.0.0.1
PROXY_PORT=7897
