# ============================================
# LLM 配置
# ============================================

# DeepSeek API Key (必填 - 默认 LLM)
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# DeepSeek 模型配置 (可选，使用默认值即可)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# LongCat API Key (可选 - 美团 LLM，作为 DeepSeek 的备用)
# 获取地址: https://longcat.chat/
# 启用后前端会出现模型选择器，可手动切换
LONGCAT_API_KEY=your-longcat-api-key

# LongCat 模型配置 (可选，使用默认值即可)
# LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
# LONGCAT_MODEL=LongCat-2.0

# 默认 LLM 供应商: deepseek 或 longcat
LLM_DEFAULT_PROVIDER=deepseek

# ============================================
# Ollama 配置 (本地向量嵌入)
# ============================================
# 安装: brew install ollama
# 启动: ollama serve
# 拉取模型: ollama pull nomic-embed-text

# ============================================
# Chroma DB 配置
# ============================================
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ============================================
# 服务器配置
# ============================================
SERVER_PORT=8080

# 知识存储路径
KNOWLEDGE_PATH=./data/knowledge

# ============================================
# 联网搜索配置
# ============================================
# 搜索提供商: searxng (推荐，需要 Docker) 或 duckduckgo (免费但可能触发验证码)
WEBSEARCH_PROVIDER=searxng

# SearXNG 本地地址 (通过 docker-compose 启动)
SEARXNG_URL=http://localhost:8081

# HTTP 代理配置 (如果在防火墙/VPN 后面，如 Clash/Surge/V2Ray)
PROXY_ENABLED=false
PROXY_HOST=127.0.0.1
PROXY_PORT=7897
